# Database Configuration
POSTGRES_DB=resume_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (optional - will be built from above if not provided)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/resume_agent

# Application Settings
DEBUG=True


# JWT Authentication Configuration
# JWT Algorithm (default: HS256)
JWT_ALG=HS256

# JWT Secret Key (REQUIRED)
# Generate a strong secret key: openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=your-secret-key-here-change-in-production
JWT_REFRESH_TOKEN_SECRET=your-secret-key-here-change-in-production

# JWT Access Token Expiration (in minutes, default: 15)
JWT_EXP=00:15:00.000000


# Refresh Token Expiration (in days, default: 30)
# Format: days=30
JWT_REFRESH_TOKEN_EXP=30d,00:00:00.000000

# Secure Cookies (default: true)
# Set to false for development over HTTP
SECURE_COOKIES=true

# Uploads directory for resume files (default: uploads)
UPLOADS_DIR=uploads

# LLM config: encryption key for user API keys (required for resume LaTeX generation)
# Use either: (1) A 64-char hex string, or (2) A Fernet key from:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CONFIG_ENCRYPTION_KEY=your-encryption-key-here-change-in-production
